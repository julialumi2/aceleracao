# Copie para .env e preencha antes de subir o compose.

# Senha do Postgres interno da Evolution API — gere uma forte:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# API key global — protege TODAS as rotas administrativas da Evolution
# API (criar instância, pegar QR code, mandar mensagem). Gere uma forte:
#   openssl rand -hex 32
AUTHENTICATION_API_KEY=

# URL pública deste serviço, depois de configurar o domínio no Dokploy
# (ex: https://evolution.artesanosburger.com.br). Sem barra no final.
EVOLUTION_SERVER_URL=

# ---------------------------------------------------------------------
# Depois que o container "api" estiver no ar e o domínio configurado,
# rode os passos abaixo UMA VEZ (local ou de qualquer máquina, trocando
# $EVOLUTION_SERVER_URL e $AUTHENTICATION_API_KEY pelos valores acima):
#
# 1. Criar a instância (o nome "aceleracao" é livre, é o que você vai usar
#    como EVOLUTION_INSTANCE no .env do asaas-proxy):
#
#    curl -X POST "$EVOLUTION_SERVER_URL/instance/create" \
#      -H "Content-Type: application/json" \
#      -H "apikey: $AUTHENTICATION_API_KEY" \
#      -d '{"instanceName":"aceleracao","qrcode":true,"integration":"WHATSAPP-BAILEYS"}'
#
# 2. Pegar o QR code pra escanear com o WhatsApp do celular que vai
#    receber os alertas (Configurações > Aparelhos conectados > Conectar
#    um aparelho):
#
#    curl "$EVOLUTION_SERVER_URL/instance/connect/aceleracao" \
#      -H "apikey: $AUTHENTICATION_API_KEY"
#
#    A resposta traz um campo "base64" — cole esse valor num conversor de
#    base64 pra imagem (ou abra num navegador como <img src="data:image/png;base64,COLE_AQUI">)
#    pra enxergar o QR code.
#
# 3. Confirmar que conectou:
#
#    curl "$EVOLUTION_SERVER_URL/instance/connectionState/aceleracao" \
#      -H "apikey: $AUTHENTICATION_API_KEY"
#
#    Deve responder com "state":"open".
# ---------------------------------------------------------------------
