# Copie para .env e preencha antes de subir o compose.

# Senha do banco — gere uma forte:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Segredo usado para assinar os JWT de autenticação — gere com:
#   openssl rand -base64 48
JWT_SECRET=

# ANON_KEY e SERVICE_ROLE_KEY são JWTs assinados com o JWT_SECRET acima.
# Gere os dois em https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# (cole seu JWT_SECRET lá) ou usando o script oficial da Supabase.
# Depois de gerar, cole os mesmos valores em volumes/api/kong.yml
# (substituindo ANON_KEY_PLACEHOLDER e SERVICE_ROLE_KEY_PLACEHOLDER).
ANON_KEY=
SERVICE_ROLE_KEY=

# URL pública do front-end (usada pelo Auth para redirects de confirmação de e-mail)
SITE_URL=https://app.seudominio.com

# URL pública deste Kong/API (o que vai virar VITE_SUPABASE_URL no front-end)
API_EXTERNAL_URL=https://supabase.seudominio.com
