PORT=3000

# Token secreto que você escolhe ao cadastrar o webhook no painel do Asaas
# (Configurações -> Integrações -> Webhooks). O Asaas reenvia esse mesmo
# valor no header "asaas-access-token" em toda chamada, e comparamos aqui.
ASAAS_WEBHOOK_TOKEN=

# URL do Supabase self-hosted (mesma do front-end).
SUPABASE_URL=https://api.aceleracao.artesanosburger.com.br

# service_role key — NUNCA a anon key. Precisa bypassar RLS pra gravar
# boletos vindos do Asaas sem estar autenticado como staff.
SUPABASE_SERVICE_ROLE_KEY=

# Token secreto que você escolhe e usa tanto aqui quanto no header
# "x-webhook-token" configurado no Database Webhook do Supabase (trigger
# na tabela leads). Confirma que a chamada realmente veio do seu banco.
LEAD_WEBHOOK_TOKEN=

# URL base da sua instância da Evolution API (ex: https://evolution.seudominio.com.br)
EVOLUTION_API_URL=

# API key global configurada na Evolution API (AUTHENTICATION_API_KEY).
EVOLUTION_API_KEY=

# Nome da instância do WhatsApp criada na Evolution API (a que você
# conectou escaneando o QR code).
EVOLUTION_INSTANCE=

# Número de WhatsApp que deve receber o alerta de lead novo, no formato
# DDI+DDD+número sem símbolos (ex: 5515991933737).
ALERT_WHATSAPP_NUMBER=

# Chave de API do Asaas (Configurações -> Integrações -> Chave de API no
# painel do Asaas). Usada pelo painel admin pra criar cliente + assinatura
# recorrente de verdade ao configurar cobrança de um cliente novo.
ASAAS_API_KEY=

# https://api.asaas.com/v3 em produção, https://api-sandbox.asaas.com/v3
# pra testar sem gerar cobrança real.
ASAAS_API_URL=https://api.asaas.com/v3

# Access Token gerado em Configurações -> API no painel do Clicksign
# (sandbox.clicksign.com pra testar, app.clicksign.com em produção).
CLICKSIGN_API_TOKEN=

# https://sandbox.clicksign.com/api/v3 (padrão, pra testar sem gerar
# contrato real) ou https://app.clicksign.com/api/v3 em produção.
CLICKSIGN_API_URL=https://sandbox.clicksign.com/api/v3

# Secret devolvido ao cadastrar o webhook (POST /webhooks no Clicksign,
# evento "close"/"document_closed" apontando pra
# .../webhooks/clicksign). Confirma que a chamada em /webhooks/clicksign
# realmente veio do Clicksign.
CLICKSIGN_WEBHOOK_SECRET=

# App ID e App Secret do App criado em developers.facebook.com (produto
# Instagram Graph API adicionado). Usados pra conectar o Instagram de
# cada cliente e puxar posts/alcance na aba Intensidade.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Precisa ser cadastrada em Facebook Login -> Configurações -> "URIs de
# redirecionamento OAuth válidos" no painel do App, exatamente igual.
INSTAGRAM_REDIRECT_URI=https://asaas.aceleracao.artesanosburger.com.br/instagram/callback

# URL pública do site — pra onde mandamos o cliente de volta depois do
# login com o Facebook (telas /conectar-instagram/sucesso e /erro).
FRONTEND_URL=https://aceleracao.artesanosburger.com.br
