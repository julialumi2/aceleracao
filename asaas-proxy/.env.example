PORT=3000

# Token secreto que você escolhe ao cadastrar o webhook no painel do Asaas
# (Configurações -> Integrações -> Webhooks). O Asaas reenvia esse mesmo
# valor no header "asaas-access-token" em toda chamada, e comparamos aqui.
ASAAS_WEBHOOK_TOKEN=

# URL do Supabase self-hosted (mesma do front-end).
SUPABASE_URL=https://api.aceleracao.artesanosburger.com.br

# service_role key — NUNCA a anon key. Precisa bypassar RLS pra gravar
# boletos vindos do Asaas sem estar autenticado como staff.
SUPABASE_SERVICE_ROLE_KEY=

# Token secreto que você escolhe e usa tanto aqui quanto no header
# "x-webhook-token" configurado no Database Webhook do Supabase (trigger
# na tabela leads). Confirma que a chamada realmente veio do seu banco.
LEAD_WEBHOOK_TOKEN=

# URL base da sua instância da Evolution API (ex: https://evolution.seudominio.com.br)
EVOLUTION_API_URL=

# API key global configurada na Evolution API (AUTHENTICATION_API_KEY).
EVOLUTION_API_KEY=

# Nome da instância do WhatsApp criada na Evolution API (a que você
# conectou escaneando o QR code).
EVOLUTION_INSTANCE=

# Número de WhatsApp que deve receber o alerta de lead novo, no formato
# DDI+DDD+número sem símbolos (ex: 5515991933737).
ALERT_WHATSAPP_NUMBER=
